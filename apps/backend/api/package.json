{
  "name": "@ethio-tour/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "dependencies": {
    "@ethio-tour/authz": "workspace:*",
    "@ethio-tour/backend-domain": "workspace:*",
    "@ethio-tour/contracts": "workspace:*",
    "@ethio-tour/db": "workspace:*",
    "@nestjs/common": "11.0.11",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.0.11",
    "@nestjs/platform-express": "11.0.11",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "jose": "6.2.12",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint . --max-warnings=0",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "tsx": "4.19.2"
  }
