FROM node:22.14.0-bookworm-slim AS foundation

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV NODE_ENV=production
WORKDIR /workspace

RUN npm install --global --no-audit --no-fund pnpm@12.5.1

COPY . .
RUN pnpm install --frozen-lockfile

ARG APP_NAME
ENV APP_NAME=${APP_NAME}
RUN pnpm --filter @ethio-tour/${APP_NAME}... build

CMD ["sh", "-c", "pnpm --filter @ethio-tour/${APP_NAME} start"]
