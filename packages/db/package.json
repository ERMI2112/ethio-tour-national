{
  "name": "@ethio-tour/db",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing/disposable-database-target": {
      "types": "./dist/disposable-database-target.d.ts",
      "default": "./dist/disposable-database-target.js"
    }
  },
  "typesVersions": {
    "*": {
      "testing/disposable-database-target": [
        "dist/disposable-database-target.d.ts"
      ]
    }
  },
  "dependencies": {
    "drizzle-orm": "0.38.3",
    "postgres": "3.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "0.30.2",
    "tsx": "4.19.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "tsx src/migrate-cli.ts",
    "db:migrate:disposable": "tsx src/migrate-disposable-cli.ts",
    "db:seed:demo": "tsx src/demo-seed-cli.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:hotel:migration": "vitest run src/hotel-migration.test.ts src/hotel-multi-office-migration.test.ts src/disposable-database-target.test.ts"
  }
}
